# ==============================================================================
# CasaFinance — Environment Variables Template
# Copy this file to .env and customize secrets before starting containers:
#   cp .env.example .env
# ==============================================================================

# Node Environment & Port
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# Administrative & Microservices Security Tokens
# ------------------------------------------------------------------------------
# Secret token for administrative operations (destructive factory reset, backups, settings)
ADMIN_TOKEN=your_secure_admin_token_here

# Secret token shared between CasaFinance core API and companion bots (WhatsApp/Telegram)
BOT_API_TOKEN=your_secure_bot_api_token_here

# ------------------------------------------------------------------------------
# Optional Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_NAME=Gastos Casa

# ------------------------------------------------------------------------------
# Data Storage Path (defaults to ./data in Docker)
# ------------------------------------------------------------------------------
DATA_DIR=/app/data
